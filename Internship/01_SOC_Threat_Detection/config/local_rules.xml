<!-- Merge into existing local_rules.xml; do not overwrite other rules blindly. -->
<group name="local,syslog,sshd,">
  <rule id="100010" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Repeated Windows failed logins against the same account within 2 minutes.</description>
    <group>authentication_failed,windows,brute_force,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100020" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\notepad\.exe$</field>
    <description>SOC Lab: Notepad process creation detected</description>
    <group>windows,sysmon,process_creation,</group>
  </rule>
  <rule id="100021" level="7">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <description>SOC Lab: PowerShell process execution detected</description>
    <group>windows,sysmon,powershell,process_creation,</group>
  </rule>
  <rule id="100030" level="10">
    <if_group>sysmon_event_22</if_group>
    <field name="win.eventdata.queryName" type="pcre2">(?i)^.{100,}$</field>
    <description>SOC Lab: Unusually long DNS query detected - possible DNS tunnelling</description>
    <group>dns,dns_tunneling,windows,sysmon,</group>
    <mitre><id>T1071.004</id></mitre>
  </rule>
</group>
